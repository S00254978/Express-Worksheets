@endpoint = http://localhost:3000/cars
@apiKey = blahblah

### Protected route without an API key
GET {{endpoint}}

### Get all cars with an API key
GET {{endpoint}}
x-api-key: {{apiKey}}


### @name postACar
POST {{endpoint}}
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "make": "make2",
  "model": "model2"
}


@newCar = {{postACar.response.body._id}}

### Get the new car
GET {{endpoint}}/{{newCar}}
x-api-key: {{apiKey}}


### Update the new car
PUT {{endpoint}}/{{newCar}}
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "make": "updated make",
### Delete the new car
  "model": "updated model"
}

DELETE {{endpoint}}/{{newCar}}
x-api-key: {{apiKey}}

### Invalid ID test
DELETE {{endpoint}}/not-a-valid-id
x-api-key: {{apiKey}}
