@endpoint = http://localhost:3000/api/v1/cars
@apiKey = blahblah

### Read routes are public
GET {{endpoint}}

### @name postACar
POST {{endpoint}}
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "make": "make4",
  "model": "model3"
}

###
@newCar = {{postACar.response.body._id}}

### Get the new car
GET {{endpoint}}/{{newCar}}

### Update the new car
PUT {{endpoint}}/{{newCar}}
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "make": "updated make",
  "model": "updated model"
}

### Delete the new car
DELETE {{endpoint}}/{{newCar}}
x-api-key: {{apiKey}}

### Invalid ID test
DELETE {{endpoint}}/not-a-valid-id
x-api-key: {{apiKey}}

### Valid ID that does not exist
DELETE {{endpoint}}/000000000000000000000000
x-api-key: {{apiKey}}
