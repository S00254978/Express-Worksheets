@endpoint = http://localhost:3000/cars

### Get all cars
GET {{endpoint}}

### Create a car
# @name postACar
POST {{endpoint}}
Content-Type: application/json

{
  "make": "make2",
  "model": "model2"
}

### Get the car created above
@newCar = {{postACar.response.body._id}}

GET {{endpoint}}/{{newCar}}

### Update the car created above
PUT {{endpoint}}/{{newCar}}
Content-Type: application/json

{
  "make": "updated make",
  "model": "updated model"
}

### Delete the car created above
DELETE {{endpoint}}/{{newCar}}

### Invalid ID test
DELETE {{endpoint}}/not-a-valid-id
